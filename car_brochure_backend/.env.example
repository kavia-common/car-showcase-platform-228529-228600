# Postgres (provided by car_brochure_db container)
POSTGRES_URL=localhost
POSTGRES_PORT=5000
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myapp

# Optional alternative DSN format
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Admin HTTP Basic credentials (required for /admin/* endpoints)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
